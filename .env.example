# VetShield 305 — semua variabel opsional. Tanpa file .env, aplikasi tetap
# berjalan penuh dengan engine deterministik dan penyimpanan lokal.

# Salt untuk hash teks pesan sebelum disimpan. Ganti di produksi.
PII_HASH_SALT=change-me-before-deploy

# Retensi cuplikan teredaksi di penyimpanan lokal (hari)
RETENTION_DAYS=7

# Batas keyakinan minimum; di bawah ini hasil menjadi insufficient_info
MIN_CONFIDENCE=0.4

# TTL cache hasil analisis (detik)
CACHE_TTL=600

# Batas permintaan analisis per menit per IP
ANALYZE_RATE_LIMIT=30

# Batas kiriman skor pre/post per menit per IP (satu kelas bisa satu IP)
PREPOST_RATE_LIMIT=60

# Snowflake (opsional). Isi kredensial agar dashboard memakai warehouse.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=VETSHIELD_DB
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_ROLE=

